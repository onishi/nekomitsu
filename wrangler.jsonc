{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekomitsu",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 監視用エンドポイントは SPA のフォールバックより先に Worker で受ける
    "run_worker_first": ["/_monitor/*"]
  },
  // 公開は独自ドメインのみ（workers.dev のURLは使わない）
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "nekomitsu.wagaya.org", "custom_domain": true }]
}
